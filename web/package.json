{
  "name": "goose-3d-browser-assets",
  "version": "0.1.0",
  "description": "Browser asset helpers and TypeScript declarations for Goose 3D",
  "type": "module",
  "scripts": {
    "test": "node ./test_assets.mjs && node ./test_orbit_controls.mjs && node ./test_package_exports.mjs && node ./test_package_tarball.mjs",
    "prepublishOnly": "npm test"
  },
  "exports": {
    ".": {
      "types": "./assets.d.ts",
      "import": "./assets.js"
    },
    "./orbit-controls": {
      "types": "./orbit-controls.d.ts",
      "import": "./orbit-controls.js"
    }
  },
  "files": [
    "assets.js",
    "assets.d.ts",
    "orbit-controls.js",
    "orbit-controls.d.ts"
  ],
  "sideEffects": false
}
