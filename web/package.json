{
  "name": "gs3d",
  "version": "0.1.0",
  "description": "Browser asset helpers and TypeScript declarations for Goose 3D",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node ./test_webgpu_uploads.mjs && node ./test_assets.mjs && node ./test_orbit_controls.mjs && node ./test_three_facade.mjs && npm run test:three-upstream && node ./test_package_exports.mjs && node ./test_reference_test_server.mjs && node ./test_publish_metadata.mjs && node ./test_package_tarball.mjs && npm run test:model-authoring",
    "test:three-upstream": "node ./test_three_upstream.mjs",
    "build:robot": "node --experimental-strip-types ./viewer/generate_robot.ts",
    "build:sample": "node --experimental-strip-types ./viewer/generate_sample.ts",
    "test:model-authoring": "node --experimental-strip-types ./test_model_authoring.ts",
    "test:browser": "../build_web.sh --reference-checks && ../build_web.sh --animation-benchmark && node ./test_browser_reference.mjs",
    "prepublishOnly": "npm test && node ./check_publish_metadata.mjs"
  },
  "exports": {
    ".": {
      "types": "./assets.d.ts",
      "import": "./assets.js"
    },
    "./orbit-controls": {
      "types": "./orbit-controls.d.ts",
      "import": "./orbit-controls.js"
    },
    "./three": {
      "types": "./three.d.ts",
      "import": "./three.js"
    },
    "./webgpu": {
      "types": "./three.d.ts",
      "import": "./three.js"
    },
    "./gltf-loader": {
      "types": "./gltf-loader.d.ts",
      "import": "./gltf-loader.js"
    },
    "./gltf-exporter": {
      "types": "./gltf-exporter.d.ts",
      "import": "./gltf-exporter.js"
    }
  },
  "files": [
    "assets.js",
    "assets.d.ts",
    "orbit-controls.js",
    "orbit-controls.d.ts",
    "three.js",
    "three.d.ts",
    "gltf-loader.js",
    "gltf-loader.d.ts",
    "gltf-exporter.js",
    "gltf-exporter.d.ts",
    "gs3d/app.js",
    "gs3d/app.wasm",
    "LICENSE"
  ],
  "sideEffects": false
}
